[Icon Theme]
Name=Surfn-Paper
Comment=Paper's folders and classic icons over the modern Surfn icon set
Inherits=Surfn,Paper,hicolor
Example=folder
FollowsColorScheme=true
DisplayDepth=32

DesktopDefault=48
DesktopSizes=16,22,24,32,48,64,96,128
ToolbarDefault=22
ToolbarSizes=16,22,24,32,48
SmallDefault=16
SmallSizes=16,22,24,32,48
DialogDefault=32

Directories=places/16,places/22,places/24,places/32,places/48,places/64,places/96,places/128,categories/16,categories/22,categories/24,categories/32,categories/48,categories/64,categories/96,categories/128,apps/16,apps/22,apps/24,apps/32,apps/48,apps/64,apps/96,apps/128,mimetypes/16,mimetypes/22,mimetypes/24,mimetypes/32,mimetypes/48,mimetypes/64,mimetypes/96,mimetypes/128,actions/symbolic,apps/symbolic,categories/symbolic,devices/symbolic,emblems/symbolic,emotes/symbolic,mimetypes/symbolic,places/symbolic,status/symbolic
ScaledDirectories=places/16@2x,places/22@2x,places/24@2x,places/32@2x,places/48@2x,places/64@2x,places/96@2x,places/128@2x,categories/16@2x,categories/22@2x,categories/24@2x,categories/32@2x,categories/48@2x,categories/64@2x,categories/96@2x,categories/128@2x,apps/16@2x,apps/22@2x,apps/24@2x,apps/32@2x,apps/48@2x,apps/64@2x,apps/96@2x,apps/128@2x,mimetypes/16@2x,mimetypes/22@2x,mimetypes/24@2x,mimetypes/32@2x,mimetypes/48@2x,mimetypes/64@2x,mimetypes/96@2x,mimetypes/128@2x

