# Kiro-Paper XFWM4 decoration
#
# Mirrors Kiro-Paper/gtk-3.0:
#   title bar   #636e73        backdrop #454d50
#   bottom line #4f585c        backdrop #3c4346
#   frame       #e6e6e6        radius 4px
#   close hover #d9534f        (GTK headerbar windowcontrols)

button_offset=2
button_spacing=2

show_app_icon=false

full_width_title=true

title_shadow_active=false
title_shadow_inactive=false

title_horizontal_offset=6
title_vertical_offset_active=0
title_vertical_offset_inactive=0

active_text_color=#ffffff
active_text_shadow_color=#4f585c

inactive_text_color=#c3c9cc
inactive_text_shadow_color=#3c4346

# GTK 3 decoration shadow: 0 3px 9px 1px rgba(0,0,0,.32)
shadow_delta_height=4
shadow_delta_width=0
shadow_delta_x=0
shadow_delta_y=4
shadow_opacity=36

frame_border_top=4
